PORT=3000

# SMTP settings (fill to enable email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=strong-password

# Where contact messages should be delivered
CONTACT_TO=contact@example.com
# Optional FROM override
CONTACT_FROM=website@sotel.td

